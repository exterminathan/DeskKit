{
  "$schema": "../../schemas/module.schema.json",
  "schema_version": 1,
  "id": "template-python",
  "name": "Hello (Python)",
  "version": "0.1.0",
  "description": "Template module in Python: prints a greeting from its settings file and exits.",
  "source": "in-repo",
  "repo": null,
  "runtime": { "type": "python", "min": "3.11", "requirements": null },
  "entry": "src/hello.py",
  "args": [],
  "console": true,
  "run_mode": "oneshot",
  "instance": { "single": false, "mutex": null, "show_event": null, "stop_event": null },
  "actions": [
    { "id": "greet-nate", "label": "Greet Nate", "args": ["Nate"] }
  ],
  "autostart": { "default": false, "managed_by": "shell" },
  "icon": null,
  "data_dir": "%APPDATA%\\DeskKit\\template-python",
  "settings_path": "{data_dir}\\settings.json",
  "settings_action": null,
  "launcher": "launch.cmd",
  "helpers": [],
  "licence": "MIT",
  "homepage": null,
  "notes": "Template. Copy this folder to modules/<id>/ and follow docs/module-contract.md section 14. For a tray or window module, set single true and the three instance names, and add the single-instance code (contract 7.2)."
}
